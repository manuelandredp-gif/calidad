generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String        @map("password_hash")
  fullName     String        @map("full_name")
  role         String        @default("QA_TESTER") // QA_TESTER, QA_LEAD, DEVELOPER, ADMIN
  isActive     Boolean       @default(true) @map("is_active")
  preferences  Json?         @default("{}")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  projects            Project[]
  reviews             TestCaseReview[]
  sessions            AuthSession[]
  aiGenerations       AiGeneration[]
  requirementVersions RequirementVersion[]

  @@map("users")
}

model AuthSession {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  isRevoked    Boolean   @default(false) @map("is_revoked")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("auth_sessions")
}

model Project {
  id                    String        @id @default(uuid())
  name                  String
  description           String?
  ownerId               String        @map("owner_id")
  status                String        @default("ACTIVE") // ACTIVE, ARCHIVED
  budgetUsd             Float?        @map("budget_usd")
  nextRequirementNumber Int           @default(1) @map("next_requirement_number")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  requirements Requirement[]

  @@index([ownerId])
  @@index([status])
  @@map("projects")
}

model Requirement {
  id                 String               @id @default(uuid())
  projectId          String               @map("project_id")
  code               String               // ej. REQ-001
  title              String
  description        String
  acceptanceCriteria String               @map("acceptance_criteria")
  version            Int                  @default(1)
  status             String               @default("READY_FOR_AI") // READY_FOR_AI, GENERATED, OBSOLETE
  nextCaseNumber     Int                  @default(1) @map("next_case_number")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases     TestCase[]
  aiGenerations AiGeneration[]
  versions      RequirementVersion[]

  @@unique([projectId, code])
  @@index([projectId])
  @@index([status])
  @@map("requirements")
}

model RequirementVersion {
  id                 String      @id @default(uuid())
  requirementId      String      @map("requirement_id")
  version            Int
  title              String
  description        String
  acceptanceCriteria String      @map("acceptance_criteria")
  authorId           String?     @map("author_id")
  changeSummary      String?     @map("change_summary")
  createdAt          DateTime    @default(now()) @map("created_at")

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  author      User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([requirementId, version])
  @@index([requirementId])
  @@map("requirement_versions")
}

model AiGeneration {
  id                 String      @id @default(uuid())
  requirementId      String      @map("requirement_id")
  userId             String?     @map("user_id")
  requirementVersion Int         @default(1) @map("requirement_version")
  provider           String      // gemini, openai
  model              String      // gemini-2.5-flash-lite, gpt-5-nano, etc.
  promptVersion      String      @default("v1.0") @map("prompt_version")
  inputTokens        Int         @map("input_tokens")
  outputTokens       Int         @map("output_tokens")
  estimatedCost      Float?      @map("estimated_cost") // null si desconocido
  responseTimeMs     Int         @map("response_time_ms")
  inputHash          String?     @map("input_hash")
  status             String      @default("SUCCEEDED") // SUCCEEDED, FAILED
  errorMessage       String?     @map("error_message")
  rawResponse        Json?       @map("raw_response")
  createdAt          DateTime    @default(now()) @map("created_at")

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  testCases   TestCase[]

  @@index([requirementId])
  @@index([requirementId, inputHash])
  @@index([userId])
  @@map("ai_generations")
}

model TestCase {
  id                 String           @id @default(uuid())
  requirementId      String           @map("requirement_id")
  generationId       String?          @map("generation_id")
  code               String           // ej. CP-001
  type               String           // positive, negative, alternative, boundary, validation
  title              String
  preconditions      Json             @default("[]")
  steps              Json             @default("[]")
  testData           String?          @map("test_data")
  expectedResult     String           @map("expected_result")
  priority           String           @default("medium") // high, medium, low
  evidenceStatus     String           @default("pending") // derived, suggested, ambiguous, conflict, pending
  evidenceText       String?          @map("evidence_text")
  originalContent    Json?            @map("original_content") // Snapshot inmutable de la salida inicial
  version            Int              @default(1) // Versión de revisión (para bloqueo optimista)
  requirementVersion Int              @default(1) @map("requirement_version")
  isObsolete         Boolean          @default(false) @map("is_obsolete")
  source             String           @default("AI_GENERATED") // AI_GENERATED, MANUAL
  status             String           @default("PENDING") // PENDING, APPROVED, MODIFIED, REJECTED
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  requirement Requirement      @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  generation  AiGeneration?    @relation(fields: [generationId], references: [id], onDelete: SetNull)
  reviews     TestCaseReview[]

  @@unique([requirementId, code])
  @@index([requirementId])
  @@index([generationId])
  @@index([status])
  @@index([isObsolete])
  @@map("test_cases")
}

model TestCaseReview {
  id                         String   @id @default(uuid())
  testCaseId                 String   @map("test_case_id")
  reviewerId                 String   @map("reviewer_id")
  decision                   String   // APPROVED, MODIFIED, REJECTED
  comments                   String?
  justification              String?  // Obligatoria para aprobar conflictos
  reviewedRequirementVersion Int      @default(1) @map("reviewed_requirement_version")
  previousContent            Json     @map("previous_content") // Snapshot completo antes
  newContent                 Json     @map("new_content") // Snapshot completo después
  createdAt                  DateTime @default(now()) @map("created_at")

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  reviewer User     @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([testCaseId])
  @@index([reviewerId])
  @@map("test_case_reviews")
}
