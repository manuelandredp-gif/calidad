# ==============================================================================
#  TestGenAI Backend — Plantilla de variables de entorno
#  Copie este archivo a `.env` y complete los valores. NUNCA versione `.env`.
#  La aplicación valida estas variables al arrancar (src/config/env.ts) y NO
#  inicia si falta alguna crítica o si son inseguras en producción.
# ==============================================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development                 # development | test | production
LOG_LEVEL=info                       # fatal | error | warn | info | debug | trace | silent

# --- Base de Datos ---
# Opción 1: SQLite local (desarrollo rápido, sin Docker)
DATABASE_URL="file:./dev.db"
# Opción 2: PostgreSQL con Docker (docker compose up -d) — requiere schema.postgres.prisma
# DATABASE_URL="postgresql://postgres:postgres_password_2026@localhost:5432/calidad_db?schema=public"
# Opción 3: PostgreSQL en la nube (Supabase / Neon / Railway)
# DATABASE_URL="postgresql://usuario:clave@host:5432/db?sslmode=require"

# --- Seguridad / Autenticación (OBLIGATORIO) ---
# En producción debe ser un secreto aleatorio de >= 32 caracteres.
# Genere uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambie_esto_por_un_secreto_aleatorio_largo_y_unico"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12                     # 10-15 (costo de hashing de contraseñas)

# --- CORS ---
# En desarrollo puede ser "*". En producción, lista separada por comas de orígenes.
# Ej.: CORS_ORIGINS="https://app.midominio.com,https://admin.midominio.com"
CORS_ORIGINS="*"

# --- Inteligencia Artificial ---
AI_PROVIDER_DEFAULT="mock"           # gemini | openai | mock
GEMINI_API_KEY=""                    # requerido solo si AI_PROVIDER_DEFAULT=gemini
OPENAI_API_KEY=""                    # requerido solo si AI_PROVIDER_DEFAULT=openai
AI_REQUEST_TIMEOUT_MS=30000          # timeout por llamada a la IA
AI_MAX_RETRIES=2                     # reintentos ante fallos transitorios
AI_PROJECT_BUDGET_USD=5              # presupuesto máx. de IA por proyecto (0 = sin límite)
