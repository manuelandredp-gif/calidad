# ============================================================
#  TestGenAI — Reglas de exclusión de Git
# ============================================================

# Dependencias
node_modules/
**/node_modules/
.pnp
.pnp.js

# Variables de entorno y secretos (NUNCA versionar)
.env
.env.*
!.env.example
**/.env
!**/.env.example

# Compilados / build
dist/
build/
*.tsbuildinfo

# Base de datos local SQLite (datos efímeros de desarrollo)
*.db
*.db-shm
*.db-wal
**/prisma/dev.db*

# Prisma (artefactos generados)
**/.prisma/
**/node_modules/.prisma/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cobertura de tests
coverage/
.nyc_output/

# Cachés de herramientas
.cache/
.eslintcache

# Editores / SO
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
